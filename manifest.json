{
  "manifest_version": "0.3",
  "name": "geonames-mcp-server",
  "display_name": "geonames-mcp-server",
  "version": "0.1.0",
  "description": "Search GeoNames places, walk admin hierarchies, reverse geocode, get postal codes and country info.",
  "author": { "name": "cyanheads" },
  "repository": {
    "type": "git",
    "url": "https://github.com/cyanheads/geonames-mcp-server"
  },
  "homepage": "https://github.com/cyanheads/geonames-mcp-server#readme",
  "license": "Apache-2.0",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "typescript",
    "geonames",
    "gazetteer",
    "geography",
    "geocoding",
    "reverse-geocoding",
    "postal-code",
    "administrative-divisions",
    "toponym"
  ],
  "server": {
    "type": "node",
    "entry_point": "dist/index.js",
    "mcp_config": {
      "command": "node",
      "args": ["${__dirname}/dist/index.js"],
      "env": {
        "MCP_TRANSPORT_TYPE": "stdio",
        "MCP_AUTH_MODE": "none",
        "NODE_ENV": "production",
        "GEONAMES_USERNAME": "${user_config.geonames_username}"
      }
    }
  },
  "compatibility": {
    "runtimes": { "node": ">=24.0.0" }
  },
  "tools_generated": true,
  "prompts_generated": true,
  "user_config": {
    "geonames_username": {
      "type": "string",
      "title": "GeoNames username",
      "description": "Your GeoNames account (free at geonames.org; enable free web services on its account page). Leave blank to pass geonamesUsername on each call instead.",
      "sensitive": true,
      "required": false,
      "default": ""
    }
  }
}
